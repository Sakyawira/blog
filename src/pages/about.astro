---
import BlogLayout from '@/layouts/BlogLayout.astro';
---

<BlogLayout title="About" description="About Sakya Idea Corner and the person writing it.">
  <section class="mx-auto w-full max-w-3xl px-6 pb-24 pt-14 lg:pt-20">
    <p class="eyebrow">A little context</p>
    <h1 class="mt-5 font-heading text-6xl font-semibold leading-none tracking-tight sm:text-8xl">
      About
    </h1>
    <div class="article-body typeset typeset-reading mt-12">
      <p>
        Sakya Idea Corner is a personal blog for ideas that deserve more room than a post or a bookmark.
      </p>
      <p>
        I write about building software, designing interfaces, learning in public, and the strange
        little details that make a project come alive.
      </p>
      <h2>Published in the open</h2>
      <p>
        Every article lives in Markdown in the repository. A commit starts the build, Astro turns
        the words into static pages, and GitHub Pages publishes the result.
      </p>
    </div>
  </section>
</BlogLayout>
