---
import BlogLayout from '@/layouts/BlogLayout.astro';
---

<BlogLayout title="Page not found">
  <section class="mx-auto w-full max-w-3xl px-6 pb-24 pt-24">
    <p class="eyebrow">404</p>
    <h1 class="mt-5 font-heading text-6xl font-semibold tracking-tight">This note wandered off.</h1>
    <p class="mt-6 max-w-lg text-lg leading-8 text-muted-foreground">
      The page you were looking for does not exist, or it has not been written yet.
    </p>
    <a
      class="mt-8 inline-flex rounded-md bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground hover:opacity-90"
      href={import.meta.env.BASE_URL}>Return home</a
    >
  </section>
</BlogLayout>
