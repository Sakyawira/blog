---
import ThemeToggle from '@/components/ThemeToggle';
import WhaleMark from '@/components/WhaleMark.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<header
  class="sticky top-0 z-40 w-full border-b border-border/60 bg-background/90 py-5 backdrop-blur-md"
>
  <div class="mx-auto flex w-full max-w-6xl min-w-0 items-center justify-between gap-4 px-6">
    <a
      href={base}
      class="group flex min-w-0 shrink items-center gap-3"
      aria-label="Sakya Idea Corner home"
    >
      <WhaleMark class="size-9 shrink-0 transition-transform group-hover:-translate-y-0.5" />
      <span
        class="hidden whitespace-nowrap font-heading text-2xl font-semibold tracking-tight sm:inline"
      >
        Sakya Idea Corner
      </span>
    </a>

    <nav class="flex shrink-0 items-center gap-1 text-sm font-medium" aria-label="Main navigation">
      <a
        class="hidden rounded-md px-3 py-2 text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground sm:inline-block"
        href={`${base}writing/`}>Writing</a
      >
      <a
        class="hidden rounded-md px-3 py-2 text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground sm:inline-block"
        href={`${base}about/`}>About</a
      >
      <a
        class="rounded-md px-3 py-2 text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
        href="https://github.com/sakyawira/blog"
        target="_blank"
        rel="noreferrer">GitHub</a
      >
      <ThemeToggle client:load />
    </nav>
  </div>
</header>
